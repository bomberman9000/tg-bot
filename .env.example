# Токен того бота, который реально запускаешь (от @BotFather)
# ⚠️  ОБЯЗАТЕЛЬНО замени CHANGE_ME на реальный токен!
BOT_TOKEN=CHANGE_ME
BOT_USERNAME=your_bot_username

REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql+asyncpg://bot:botpass@postgres:5432/botdb

# ⚠️  ОБЯЗАТЕЛЬНО замени на свой реальный Telegram user_id
# Узнать свой ID можно у бота @userinfobot
ADMIN_ID=123456789

DEBUG=false
ADMIN_USERNAME=admin

# ⚠️  ОБЯЗАТЕЛЬНО смени пароль перед деплоем!
ADMIN_PASSWORD=change_me

# ⚠️  ОБЯЗАТЕЛЬНО смени на случайную строку (минимум 32 символа) перед деплоем!
# Пример генерации: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# Публичный URL приложения для WebApp (например https://yourdomain.com)
WEBAPP_URL=

# Ключ Groq API для умного поиска /find и AI (опционально)
# GROQ_API_KEY=
